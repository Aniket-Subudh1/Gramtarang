# ---------------------------------------------------------------
# Admin console (admin.gramtarang.org.in)
# ---------------------------------------------------------------
# Password people type on the admin sign-in screen.
ADMIN_PASSWORD=change-me-to-something-long

# Random 32+ char string used to sign the admin session cookie.
# Generate one with:  openssl rand -base64 32
ADMIN_SESSION_SECRET=change-me-too

# ---------------------------------------------------------------
# Inquiry storage — Upstash Redis (free tier, no server to run)
# Create a database at https://console.upstash.com then copy the
# two "REST API" values here and into Vercel's env vars.
# ---------------------------------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---------------------------------------------------------------
# Optional
# ---------------------------------------------------------------
# Where the admin console lives. Used for links + host routing.
NEXT_PUBLIC_ADMIN_HOST=admin.gramtarang.org.in
NEXT_PUBLIC_SITE_URL=https://gramtarang.org.in
